      <column caption='No. Cities' datatype='integer' name='[Calculation_1005710151467298816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_city])' />
      </column>
      <column aggregation='Count' caption='purchase_time HR' datatype='datetime' datatype-customized='true' name='[Calculation_1005710151467876353]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATEPARSE ( &quot;HH&quot;, STR(DATEPART(&apos;hour&apos;, [purchase_time])) ) ' />
      </column>
      <column caption='Max Orders Per Hour' datatype='integer' name='[Calculation_1005710151468466180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED DATEPART(&apos;hour&apos;, [Calculation_1005710151467876353]): [Calculation_488359144262725636] }' />
      </column>
      <column caption='Peak Hour' datatype='integer' name='[Calculation_1005710151468642309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF { FIXED: MAX({ FIXED DATEPART(&apos;hour&apos;, [Calculation_1005710151467876353]): [Calculation_488359144262725636] }) } &#13;&#10;= { FIXED DATEPART(&apos;hour&apos;, [Calculation_1005710151467876353]): [Calculation_488359144262725636] }&#13;&#10;THEN DATEPART(&apos;hour&apos;, [Calculation_1005710151467876353])&#13;&#10;END' />
      </column>
      <column caption='Total Sales' datatype='integer' name='[Calculation_488359144239394817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;  IF [order_status] &lt;&gt; &quot;canceled&quot; OR  [order_status] &lt;&gt; &quot;unavailable&quot; THEN [price] &#13;&#10;  END&#13;&#10;)' />
      </column>
      <column caption='Year Filter' datatype='integer' name='[Calculation_488359144257052675]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF YEAR([Date]) &gt;= 2016 AND YEAR([Date]) &lt;= 2018 THEN YEAR([Date]) END' />
      </column>
      <column caption='No. Orders' datatype='integer' name='[Calculation_488359144262725636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Total Freight' datatype='integer' name='[Calculation_488359144263323653]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [order_id]: MAX([freight_value]) }' />
      </column>
      <column caption='No. Custmers' datatype='integer' name='[Calculation_488359144268652552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [customer_sk (Customer)] = [customer_sk] THEN [customer_unique_id] END)' />
      </column>
