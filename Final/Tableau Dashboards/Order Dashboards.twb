    <worksheet name='Total Sales by Month'>
      <table>
        <view>
          <datasources>
            <datasource caption='OrderDashboards' name='federated.07t0muc175yjhk10hvp7u0ekwpyl' />
          </datasources>
          <datasource-dependencies datasource='federated.07t0muc175yjhk10hvp7u0ekwpyl'>
            <column caption='Total Sales' datatype='integer' name='[Calculation_488359144239394817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;  IF [order_status] &lt;&gt; &quot;canceled&quot; OR  [order_status] &lt;&gt; &quot;unavailable&quot; THEN [price] &#13;&#10;  END&#13;&#10;)' />
            </column>
            <column caption='Year Filter' datatype='integer' name='[Calculation_488359144257052675]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF YEAR([Date]) &gt;= 2016 AND YEAR([Date]) &lt;= 2018 THEN YEAR([Date]) END' />
            </column>
            <column caption='Date (Date)' datatype='date' datatype-customized='true' name='[Date]' role='dimension' type='ordinal' />
            <column caption='Customer State' datatype='string' name='[customer_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[Date]' derivation='Month' name='[mn:Date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_488359144257052675]' derivation='None' name='[none:Calculation_488359144257052675:ok]' pivot='key' type='ordinal' />
            <column-instance column='[customer_state]' derivation='None' name='[none:customer_state:nk]' pivot='key' type='nominal' />
