  <MdxScripts>
    <MdxScript dwd:design-time-name="b7a2e204-4ad0-4361-b614-7a23a6f74162">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CREATE MEMBER CURRENTCUBE.[Measures].AvgItemsPerOrder
 AS IIF(
    [Measures].[Total Orders] &gt; 0, 
    [Measures].[ItemCount] / [Measures].[Total Orders], 
    NULL
), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1;   
CREATE MEMBER CURRENTCUBE.[Measures].TotalItemsCount
 AS COUNT(
    NONEMPTY([Fact Order Sales].[Order Item Id].[Order Item Id].MEMBERS)
), 
FORMAT_STRING = "#,##0", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Order Sales'  ;  
CREATE MEMBER CURRENTCUBE.[Measures].UniqueCustomers
 AS COUNT([Fact Order Sales].[Customer Id].[Customer Id]), 
FORMAT_STRING = "#,##0", 
VISIBLE = 1;    
CREATE MEMBER CURRENTCUBE.[Measures].TotalOrders
 AS DISTINCTCOUNT([Fact Order Sales].[Order Item Id]), 
FORMAT_STRING = "#,##0", 
VISIBLE = 1;    
CREATE MEMBER CURRENTCUBE.[Measures].TotalSales
 AS SUM(
    [Fact Order Sales].[Order Id].[Order Id].MEMBERS,  
    [Measures].[Payment Value]
), 
FORMAT_STRING = "Currency", 
VISIBLE = 1;    
CREATE MEMBER CURRENTCUBE.[Measures].AvgOrderValue
 AS IIF(
    [Measures].[Total Orders] &gt; 0, 
    [Measures].[Total Sales] / [Measures].[Total Orders], 
    NULL
), 
FORMAT_STRING = "Currency", 
VISIBLE = 1;     

    CREATE MEMBER CURRENTCUBE.[Measures].ItemCount
 AS COUNT(
        NONEMPTY(
            [Fact Order Sales].[Order Item Id].MEMBERS
        )
    ), 
FORMAT_STRING = "#,##0", 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="6a9d76dd-fbd5-43e5-a13a-8af931b384c0">
      <ID>KPI</ID>
      <Name>Total Orders</Name>
      <AssociatedMeasureGroupID>Fact Order Sales</AssociatedMeasureGroupID>
      <Value>([Measures].[Total Orders])
</Value>
      <Goal>([Measures].[Total Orders]) * 1.1
</Goal>
      <Status>IIF([Measures].[Total Orders] &gt;= [Measures].[Goal], 1, -1)
</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="f8dee482-547e-4c40-a272-aa5683afa9c3">
      <ID>KPI 1</ID>
      <Name>Unique Customers</Name>
      <AssociatedMeasureGroupID>Fact Order Sales</AssociatedMeasureGroupID>
      <Value>[Measures].[Unique Customers]
</Value>
      <Goal>([Measures].[Unique Customers]) * 1.1
</Goal>
      <Status>IIF([Measures].[Unique Customers] &gt;= [Measures].[Goal], 1, -1)
</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="123a7766-dd13-4737-9b28-90599effa9e9">
      <ID>KPI 2</ID>
      <Name>Average Items per Order</Name>
      <Value>[Measures].[Total Items] / [Measures].[Total Orders]
</Value>
      <Goal>([Measures].[Average Items per Order]) * 1.05
</Goal>
      <Status>IIF([Measures].[Average Items per Order] &gt;= [Measures].[Goal], 1, -1)
</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Thermometer</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>