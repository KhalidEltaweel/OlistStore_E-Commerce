<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>Olist_DW_Data_sourcex</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>ee8d0043-b2f6-4bb3-ba4f-f9bafd1997cd</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@id">
            <Value>=Parameters!id.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select row_number()over(order by [Order_details].order_id ) [row number],
[Order_details].order_id, (New_Customer_Dim.F_name+' '+New_Customer_Dim.L_name) cutomer_name,
([dbo].[New_Seller_Dim].[F_name]+' '+New_Seller_Dim.L_name) seller_name,product_dim.product_id ,
Product_Dim.product_category_name,cast(price as decimal (8,2)) price,
cast(freight_value as decimal(8,2)) freight_value ,[dbo].[Order_details].Customer_zipcode
,order_details.order_purchase_timestamp
from [dbo].[Order_details],New_Customer_Dim,New_Seller_Dim,[dbo].[Product_Dim]
where [Order_details].customer_id=New_Customer_Dim.customer_id
and [Order_details].seller_id=New_Seller_Dim.seller_id
and [Order_details].product_id=[Product_Dim].product_id
and @id = [Order_details].order_id</CommandText>
      </Query>
      <Fields>
        <Field Name="row_number">
          <DataField>row number</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="order_id">
          <DataField>order_id</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="cutomer_name">
          <DataField>cutomer_name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="seller_name">
          <DataField>seller_name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="product_id">
          <DataField>product_id</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="product_category_name">
          <DataField>product_category_name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="price">
          <DataField>price</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="freight_value">
          <DataField>freight_value</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Customer_zipcode">
          <DataField>Customer_zipcode</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="order_purchase_timestamp">
          <DataField>order_purchase_timestamp</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
