<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=.;Initial Catalog=Olist_DW</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>e0e489fe-1063-4515-bfb0-950b0e688e07</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Payment_Type_Parammeter">
            <Value>=Parameters!Payment_Type_Parammeter.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Year_Parameter">
            <Value>=Parameters!Year_Parameter.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT Order_details.order_id, Order_details.product_id, Order_details.price, Order_details.freight_value, Order_details.customer_id, Order_details.order_status_id, Order_details.order_purchase_timestamp, Order_details.order_approved_at, 
                  Order_details.order_delivered_carrier_date, Order_details.order_delivered_customer_date, Order_details.order_estimated_delivery_date, Order_details.payment_type, Order_details.payment_installments, Order_details.payment_value, 
                  Order_details.review_score, Order_details.review_comment_title, Order_details.review_comment_message, Order_details.review_creation_date, Order_details.review_answer_timestamp, Order_details.shipping_limit_date, 
                  Order_details.seller_id
FROM     Order_details INNER JOIN
                  DimDate ON Order_details.DateKey_purchase_timestamp = DimDate.DateKey INNER JOIN
                  Payment_Type_Dim ON Order_details.payment_type = Payment_Type_Dim.Payment_id
WHERE  (Payment_Type_Dim.Payment_type = @Payment_Type_Parammeter) AND (DimDate.Year in (@Year_Parameter))</CommandText>
      </Query>
      <Fields>
        <Field Name="order_id">
          <DataField>order_id</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="product_id">
          <DataField>product_id</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="price">
          <DataField>price</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="freight_value">
          <DataField>freight_value</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="customer_id">
          <DataField>customer_id</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="order_status_id">
          <DataField>order_status_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="order_purchase_timestamp">
          <DataField>order_purchase_timestamp</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="order_approved_at">
          <DataField>order_approved_at</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="order_delivered_carrier_date">
          <DataField>order_delivered_carrier_date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="order_delivered_customer_date">
          <DataField>order_delivered_customer_date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="order_estimated_delivery_date">
          <DataField>order_estimated_delivery_date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="payment_type">
          <DataField>payment_type</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="payment_installments">
          <DataField>payment_installments</DataField>
          <rd:TypeName>System.Byte</rd:TypeName>
        </Field>
        <Field Name="payment_value">
          <DataField>payment_value</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="review_score">
          <DataField>review_score</DataField>
          <rd:TypeName>System.Byte</rd:TypeName>
        </Field>
        <Field Name="review_comment_title">
          <DataField>review_comment_title</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="review_comment_message">
          <DataField>review_comment_message</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="review_creation_date">
          <DataField>review_creation_date</DataField>
