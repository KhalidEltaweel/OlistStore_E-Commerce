  <DataSets>
    <DataSet Name="order_ids_dataset">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>Select order_id,Count (order_item_id) as Total_items,row_number()over(order by [Order_details].order_id desc ) [row number]
From Order_details
group by order_id
order by Count (order_item_id) Desc</CommandText>
      </Query>
      <Fields>
        <Field Name="order_id">
          <DataField>order_id</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Total_items">
          <DataField>Total_items</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="row_number">
          <DataField>row number</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
